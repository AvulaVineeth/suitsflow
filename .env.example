# Application
SUITSFLOW_APP_NAME=SuitsFlow
SUITSFLOW_ENVIRONMENT=local
SUITSFLOW_DEBUG=true
SUITSFLOW_API_V1_PREFIX=/api/v1
SUITSFLOW_LOG_LEVEL=INFO

# Database
SUITSFLOW_DATABASE_URL=postgresql+asyncpg://suitsflow:suitsflow@localhost:5432/suitsflow
SUITSFLOW_DATABASE_TIMEOUT_SECONDS=3

# Local development identity (disabled by default; never enable outside local/test)
SUITSFLOW_DEVELOPMENT_AUTH_ENABLED=false
# SUITSFLOW_DEVELOPMENT_AUTH_TOKEN=<generate a random token of at least 32 characters>
# SUITSFLOW_DEVELOPMENT_USER_ID=<uuid>
# SUITSFLOW_DEVELOPMENT_TENANT_ID=<existing active tenant uuid>
# SUITSFLOW_DEVELOPMENT_ROLE=tenant_admin
